The publish landed in the stream. Now the durable pull-consumer, as file-storage-01 — the actual mechanism adapters will use:

Bash A7 test 3-4: create durable consumer and pull the message through it
IN
cd /home/bherring/dev/clodhopper/GregorsServiceBus
CREDS="infra/nats/operator/creds"

as() {
  local who="$1"; shift
  sg docker -c "docker run --rm --network gsb_default -v \"\$(pwd)/$CREDS:/creds:ro\" natsio/nats-box:0.19.7-nonroot nats --server nats://nats:4222 --creds /creds/$who.creds $*"
}

echo "### 3. Create durable pull consumer as file-storage-01 ###"
as file-storage-01 consumer add EVENTS file-storage-01-consumer \
  --filter events.files.FileWriteRequested \
  --pull --ack explicit --deliver all --replay instant --defaults

echo ""
echo "### 4. Pull the message ###"
as file-storage-01 consumer next EVENTS file-storage-01-consumer --ack

