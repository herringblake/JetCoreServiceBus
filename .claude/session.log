# Adapter Identity Manifest — Phase 1, Step A2
#
# Declarative source of truth for "who's allowed to say what" on the bus.
# The bootstrap script (Step A3) reads this file and, for each entry, issues
# one nsc User (nkey + JWT) under the `account` below, embedding that entry's
# publish/subscribe subjects as the User's NATS permissions (Design.md §4.2,
# §4.4, Decision #6).
#
# GRANULARITY: one entry per adapter *instance*, not per adapter *type*.
# The service-directory KV registry (Design.md §4.5) already keys entries as
# <subject>.<serviceId> with instance-level ids like "file-storage-01", which
# implies a deployment can run multiple independent instances of the same
# adapter type (e.g. two HTTP Adapter instances, each integrated with a
# different external API, each with its own identity/permissions). Recorded
# as Decision #18 in Design.md §2.
#
# DERIVED PERMISSIONS (computed by the bootstrap script, not hand-authored
# per entry below):
#   - KV write  -> $KV.service-directory.<subject>.<serviceId>  for every
#     subject in that entry's `subscribe` list (lets the adapter register
#     itself as a decrypt-capable recipient, and re-PUT the same key on its
#     heartbeat interval — Design.md §11 parameter table: TTL 60s / hb 20s).
#   - KV read   -> $KV.service-directory.>  for every entry that has a
#     non-empty `publish` list (a publisher must look up recipients before
#     encrypting — Design.md §4.3).
#   - Low-level NATS/JetStream API subjects (e.g. $JS.API.>, _INBOX.>)
#     needed for the client library to function are NOT enumerated here —
#     those are finalized when nats-server.conf and the bootstrap script are
#     actually written (Steps A3/A4), not part of this application-level
#     manifest.
#
# PLACEHOLDER SUBJECTS: per Design.md Decision #14, real bounded-context
# names aren't chosen yet. Subjects below follow the events.<context>.<Type>
# convention with `orders` as a stand-in, except the File Storage Adapter's
# command subjects (events.files.*), which are named in Design.md §8. The
# exact reply/result-subject scoping convention for command/response pairs
# (e.g. whether a result subject is scoped per-requester) is still TBD —
# tracked as an open item in Design.md §9 — so result subjects below are
# shared, not yet per-requester-scoped. Revisit before Phase 3 builds these
# adapters for real.

version: 1
account: GSB

adapters:

  # --- Phase 2 vertical slice (Design.md §10) — these two are used first ---

  - serviceId: webhook-listener-01
    adapterType: webhook-listener
    description: >
      Inbound HTTP webhook receiver. Converts an accepted webhook into a
      FileWriteRequested command and publishes it. Fire-and-forget from the
      HTTP caller's perspective (§8) — no reply subject needed yet.
    permissions:
      publish:
        - events.files.FileWriteRequested
      subscribe: []

  - serviceId: file-storage-01
    adapterType: file-storage-adapter
    description: >
      Command-driven file operations service (§8) — list/read/write/delete
      against local files, triggered by bus commands.
    permissions:
      publish:
        - events.files.FileWriteCompleted
        - events.files.FileReadCompleted
        - events.files.FileListCompleted
        - events.files.FileDeleteCompleted
      subscribe:
        - events.files.FileWriteRequested
        - events.files.FileReadRequested
        - events.files.FileListRequested
        - events.files.FileDeleteRequested

  # --- Remaining adapter types (Phase 3, Design.md §10) — one placeholder
  #     instance each, so the manifest schema and bootstrap script get
  #     exercised against all 6 types now, not just the Phase 2 pair. ---

  - serviceId: http-adapter-01
    adapterType: http-adapter
    description: >
      Calls a configured external REST API when triggered by a bus event;
      publishes the response back as a correlated event (§8).
    permissions:
      publish:
        - events.http.RequestCompleted
      subscribe:
        - events.orders.OrderCreated   # placeholder trigger subject

  - serviceId: rest-api-service-01
    adapterType: rest-api-service
    description: >
      "Front door" for external HTTP clients — translates inbound REST calls
      into bus events (§8).
    permissions:
      publish:
        - events.orders.OrderCreated   # placeholder published subject
      subscribe: []

  - serviceId: webhook-sender-01
    adapterType: webhook-sender
    description: >
      Subscribes to configured subjects and POSTs to an external webhook URL,
      best-effort, no retry (Decision #12). No result event published.
    permissions:
      publish: []
      subscribe:
        - events.orders.OrderCreated   # placeholder subject to relay outward

  - serviceId: db-adapter-mysql-01
    adapterType: database-adapter-mysql
    description: >
      Bidirectional (Decision #10). Write path persists bus events to MySQL;
      CDC read path tails the binlog and publishes row changes. These two
      paths deliberately use DIFFERENT subjects (see note below) so the
      adapter never consumes its own CDC output as a write-path trigger.
    permissions:
      publish:
        - events.db.orders.RowChanged   # CDC read path output — distinct
                                         # namespace from the write-path
                                         # input subject below, on purpose.
      subscribe:
        - events.orders.OrderCreated    # write path input
