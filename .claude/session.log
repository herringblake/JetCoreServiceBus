import asyncio, nats

async def main():
    nc = await nats.connect('nats://localhost:4222', user_credentials='infra/nats/operator/creds/gsb-admin.creds')
    js = nc.jetstream()
    kv = await js.key_value('service-directory')

    watcher = await kv.watch('events.files.FileWriteRequested.*')

    # initial 'no pending updates' marker
    first = await watcher.updates(timeout=2)
    print('initial marker:', first)

    await kv.put('events.files.FileWriteRequested.file-storage-01', b'{\"pub\":\"A\"}')
    await kv.put('events.orders.OrderCreated.other-adapter', b'{\"pub\":\"C\"}')  # should NOT show up
    await kv.put('events.files.FileWriteRequested.file-storage-02', b'{\"pub\":\"B\"}')

    entry1 = await watcher.updates(timeout=2)
    print('update 1:', entry1.key if entry1 else None, entry1.value if entry1 else None)
    entry2 = await watcher.updates(timeout=2)
    print('update 2:', entry2.key if entry2 else None, entry2.value if entry2 else None)
    try:
        entry3 = await watcher.updates(timeout=2)
        print('update 3 (should be None/timeout, orders event should not appear):', entry3)
    except Exception as e:
        print('update 3 timed out as expected:', type(e).__name__)

    await watcher.stop()
    for k in ['events.files.FileWriteRequested.file-storage-01','events.files.FileWriteRequested.file-storage-02','events.orders.OrderCreated.other-adapter']:
        await kv.delete(k)
    await nc.close()

asyncio.run(main())
"

