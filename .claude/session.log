    watcher = await kv.watch('events.files.FileWriteRequested.*')
    # drain initial 'caught up' marker
    await watcher.updates(timeout=2)
    # now wait with a short timeout and nothing happening - what happens?
    try:
        result = await watcher.updates(timeout=1)
        print('result on idle timeout:', result)
    except Exception as e:
        print('raised on idle timeout:', type(e).__name__, e)
    await watcher.stop()
    await nc.close()

asyncio.run(main())
