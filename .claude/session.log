=== bootstrap_auth.sh ===
     1	#!/usr/bin/env bash
     2	set -euo pipefail
     3	
     4	# infra/nats/bootstrap_auth.sh
     5	# Phase 1, Step A3 — Auth bootstrap (Design.md §11 Track A)
     6	#
     7	# Idempotently, via nsc (containerized — natsio/nats-box, no native install
     8	# per Design.md §11 parameters):
     9	#   1. Creates the Operator representing this bus, if it doesn't exist.
    10	#   2. Creates the GSB Account, if it doesn't exist, and grants it JetStream
    11	#      storage (disabled per-account by default under decentralized JWT
    12	#      auth — independent of nats-server.conf's global jetstream{} block).
    13	#   3. For each entry in adapter_identities.yaml (Step A2): creates the User
    14	#      (nkey + JWT) if it doesn't exist, then (re)applies its permissions —
    15	#      the manifest's publish/subscribe subjects, plus KV-write on its own
    16	#      recipient-registration keys (derived per the manifest header), plus a
    17	#      v1 baseline ($JS.API.>, _INBOX.>, KV-read-all) every JetStream client
    18	#      needs. That baseline isn't scoped down further in v1 — a candidate
    19	#      for tightening later, not a Phase 1 requirement.
    20	#   4. Generates a .creds file per user (JWT+nkey bundled — the idiomatic
    21	#      NATS client connection artifact; see Design.md §7.6, Decision #17-adjacent
    22	#      update) under operator/creds/.
    23	#   4b. Creates a dedicated gsb-admin identity (not an adapter) for
    24	#       provisioning shared JetStream infrastructure — used by Step A5.
    25	#   5. Generates the memory-resolver server config block (resolver.conf) —
    26	#      consumed by nats-server.conf in Step A4.
    27	#
    28	# ============================================================================
    29	# STATUS: executed and verified end-to-end against real Docker + nsc — 3
    30	# consecutive runs confirmed idempotency (no duplicate permission entries
    31	# accumulate on repeat `edit user` calls). See infra/nats/README.md's "Step
    32	# A3" section for the 3 real bugs that surfaced only by running this, not by
    33	# reading docs (stderr-vs-stdout on `--json`, ANSI codes breaking `grep -w`
    34	# on table output, `jq` assumed-but-absent on the host) — all fixed below.
    35	# ============================================================================
    36	#
    37	# Requires on the host: docker, bash. Everything else (nsc, nats CLI, YAML/
    38	# JSON parsing) runs containerized — an earlier draft assumed `jq` would be
    39	# present on the host; it wasn't, so this uses `yq` alone for both YAML and
    40	# JSON querying instead of adding another native dependency.
    41	
    42	SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    43	MANIFEST="$SCRIPT_DIR/adapter_identities.yaml"
    44	STORE_DIR="$SCRIPT_DIR/operator/nsc"        # git-ignored — nsc's JWT+nkey store
    45	CREDS_DIR="$SCRIPT_DIR/operator/creds"      # git-ignored — generated .creds files
    46	RESOLVER_CONF_NAME="resolver.conf"          # generated; consumed by Step A4
    47	
    48	NATS_BOX_IMAGE="natsio/nats-box:0.19.7-nonroot"
    49	YQ_IMAGE="mikefarah/yq:4.52.4"
    50	
    51	OPERATOR_NAME="GregorsServiceBus"
    52	ACCOUNT_NAME="GSB"
    53	ADMIN_ID="gsb-admin"   # infra-provisioning identity (Step A5), not an adapter
    54	
    55	# JetStream storage the GSB account is allowed to use — kept in step with
    56	# nats-server.conf's own jetstream{} caps (256M mem / 2G file), since a
    57	# single-account dev setup has no reason for the account limit to be lower
    58	# than the server-wide limit.
    59	JS_MEM_STORAGE="256M"
    60	JS_DISK_STORAGE="2G"
    61	
    62	# v1 baseline permissions, granted to every adapter identity in addition to
    63	# its manifest-declared subjects — needed for the JetStream client library
    64	# and NATS request-reply plumbing to function. See header note above.
    65	BASELINE_PUB='$JS.API.>'
    66	# $KV.service-identity.> read: every adapter needs to look up *any* other
    67	# adapter's registered signing key to verify a received message's sender
    68	# (Design.md §9 item #4 resolution) — read access is necessarily broad,
    69	# same as service-directory's; only the per-adapter *write* scope (own
    70	# namespace only, derived above) is what actually enforces least privilege.
    71	BASELINE_SUB='$JS.API.>,_INBOX.>,$KV.service-directory.>,$KV.service-identity.>'
    72	
    73	mkdir -p "$STORE_DIR" "$CREDS_DIR"
    74	
    75	# Run nsc in nats-box, with the store persisted to $STORE_DIR and this
    76	# directory writable at /workspace for file-producing commands (generate
    77	# config, generate creds). -u matches the container's file ownership to the
    78	# host user, avoiding the UID-1000 permission mismatch the nats-box README
    79	# otherwise works around with a manual `chown`.
    80	nsc() {
    81	  docker run --rm \
    82	    -v "$STORE_DIR:/nsc" \
    83	    -v "$SCRIPT_DIR:/workspace" \
    84	    -e NSC_HOME=/nsc \
    85	    -e NKEYS_PATH=/nsc/keys \
    86	    -u "$(id -u):$(id -g)" \
    87	    -w /workspace \
    88	    "$NATS_BOX_IMAGE" nsc "$@"
    89	}
    90	
    91	yq() {
    92	  docker run --rm -i "$YQ_IMAGE" "$@"
    93	}
    94	
    95	# Query a single field out of a JSON blob passed on stdin, via yq (-p=json).
    96	yqjson() {
    97	  local expr="$1"
    98	  yq -p=json "$expr" -
    99	}
   100	
   101	# True if `nsc <list-subcommand...> --json` includes an entry whose .name
   102	# equals $1. Two nsc quirks made this fiddlier than expected, both confirmed
   103	# by actually running it (not guessed):
   104	#   - Table output carries ANSI color codes even without a TTY, sitting
   105	#     flush against the name with no word boundary, so a plain `grep -w` on
   106	#     table output silently fails to match.
   107	#   - --json output goes to STDERR, not stdout (confirmed for `list
   108	#     operators`) — so this deliberately merges 2>&1 rather than discarding
   109	#     stderr, which is what broke idempotency on the first version of this
   110	#     script (every entity looked "not found" on every run).
   111	# (. // []) guards against nsc printing bare `null` for an empty list
   112	# (confirmed behavior of `nsc list users` on a freshly created account).
   113	nsc_has() {
   114	  local name="$1"; shift
   115	  nsc "$@" --json 2>&1 | yqjson '(. // []) | .[].name' | grep -qx "$name"
   116	}
   117	
   118	echo "== Operator: $OPERATOR_NAME =="
   119	if nsc_has "$OPERATOR_NAME" list operators; then
   120	  echo "already exists, skipping add"
   121	else
   122	  # --sys: generates a System Account alongside the operator. Confirmed via
   123	  # a real run (not just the docs) that this isn't optional — nats-server
   124	  # refuses to start JetStream under decentralized JWT auth without one
   125	  # ("[FTL] Can't start JetStream: ... system account not setup").
   126	  nsc add operator --name "$OPERATOR_NAME" --sys
   127	fi
   128	
   129	echo "== Account: $ACCOUNT_NAME =="
   130	if nsc_has "$ACCOUNT_NAME" list accounts; then
   131	  echo "already exists, skipping add"
   132	else
   133	  nsc add account --name "$ACCOUNT_NAME"
   134	fi
   135	
   136	# JetStream is disabled per-account by default under decentralized JWT auth
   137	# — entirely independent of nats-server.conf's global jetstream{} block.
   138	# Confirmed via a real run: `nsc describe account --json` showed no
   139	# .nats.limits.jetstream at all until this was added, and stream creation
   140	# would fail against a freshly-added account without it. Re-run (idempotent
   141	# edit) every time so a manifest/limit change takes effect on rerun.
   142	nsc edit account --name "$ACCOUNT_NAME" \
   143	  --js-mem-storage "$JS_MEM_STORAGE" \
   144	  --js-disk-storage "$JS_DISK_STORAGE"
   145	
   146	echo "== Users (from $MANIFEST) =="
   147	
   148	# One compact JSON line per manifest entry, read via process substitution so
   149	# the loop body's `nsc`/variable assignments run in this shell, not a
   150	# subshell (a plain `| while read` would lose them after the loop).
   151	while IFS= read -r adapter; do
   152	  service_id="$(echo "$adapter" | yqjson '.serviceId')"
   153	  adapter_type="$(echo "$adapter" | yqjson '.adapterType')"
   154	  pub_subjects="$(echo "$adapter" | yqjson '(.permissions.publish // []) | join(",")')"
   155	  sub_subjects="$(echo "$adapter" | yqjson '(.permissions.subscribe // []) | join(",")')"
   156	
   157	  # Derived: KV write on this identity's own recipient-registration keys,
   158	  # one per subscribed subject (Design.md §4.5 / adapter_identities.yaml
   159	  # header comment). Built in bash, not a nested yq expression — keeps each
   160	  # containerized yq call trivially simple to verify individually.
   161	  kv_write=""
   162	  if [ -n "$sub_subjects" ]; then
   163	    IFS=',' read -ra _subs <<<"$sub_subjects"
   164	    for s in "${_subs[@]}"; do
   165	      kv_write="${kv_write:+$kv_write,}\$KV.service-directory.$s.$service_id"
   166	    done
   167	  fi
   168	  # Every adapter — publisher or subscriber — registers its own signing
   169	  # identity once at connect time (Design.md §9 item #4 resolution / §11
   170	  # Step B6 follow-up), unlike service-directory registration, which only
   171	  # happens for subjects actually subscribed to.
   172	  kv_write="${kv_write:+$kv_write,}\$KV.service-identity.$service_id"
   173	
   174	  all_pub="$(printf '%s,%s,%s' "$pub_subjects" "$BASELINE_PUB" "$kv_write" | sed 's/,,*/,/g; s/^,//; s/,$//')"
   175	  all_sub="$(printf '%s,%s' "$sub_subjects" "$BASELINE_SUB" | sed 's/,,*/,/g; s/^,//; s/,$//')"
   176	
   177	  echo "-- $service_id ($adapter_type) --"
   178	  if nsc_has "$service_id" list users --account "$ACCOUNT_NAME"; then
   179	    echo "already exists, skipping add"
   180	  else
   181	    nsc add user --account "$ACCOUNT_NAME" --name "$service_id"
   182	  fi
   183	
   184	  nsc edit user --account "$ACCOUNT_NAME" --name "$service_id" \
   185	    --allow-pub "$all_pub" \
   186	    --allow-sub "$all_sub"
   187	
   188	  nsc generate creds --account "$ACCOUNT_NAME" --name "$service_id" \
   189	    >"$CREDS_DIR/$service_id.creds"
   190	  echo "wrote $CREDS_DIR/$service_id.creds"
   191	done < <(yq -o=json -I=0 '.adapters[]' <"$MANIFEST")
   192	
   193	echo "== Admin identity: $ADMIN_ID =="
   194	# Creating/managing the EVENTS stream and service-directory KV bucket
   195	# (Step A5) isn't any particular adapter's job — a dedicated identity keeps
   196	# "who can provision shared infrastructure" separate from "who can act as
   197	# adapter X", rather than borrowing an arbitrary adapter's creds for it.
   198	if nsc_has "$ADMIN_ID" list users --account "$ACCOUNT_NAME"; then
   199	  echo "already exists, skipping add"
   200	else
   201	  nsc add user --account "$ACCOUNT_NAME" --name "$ADMIN_ID"
   202	fi
   203	
   204	nsc edit user --account "$ACCOUNT_NAME" --name "$ADMIN_ID" \
   205	  --allow-pubsub '$JS.API.>,$KV.service-directory.>,$KV.service-identity.>,_INBOX.>'
   206	
   207	nsc generate creds --account "$ACCOUNT_NAME" --name "$ADMIN_ID" \
   208	  >"$CREDS_DIR/$ADMIN_ID.creds"
   209	echo "wrote $CREDS_DIR/$ADMIN_ID.creds"
   210	
   211	echo "== Memory resolver config =="
   212	nsc generate config --mem-resolver --force \
   213	  --config-file "$RESOLVER_CONF_NAME"
   214	echo "wrote $SCRIPT_DIR/$RESOLVER_CONF_NAME"
   215	
   216	echo "Done. Next: Step A4 wires $RESOLVER_CONF_NAME into nats-server.conf."
