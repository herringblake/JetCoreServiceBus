"""Design.md §13 Step K3 — manual end-to-end smoke test against the real,
fully-wired docker-compose stack. Not pytest; a throwaway script run
directly, matching every prior track's manual-verification style."""

import asyncio
import base64
import json

from jetcore.bus_client import BusClient
from jetcore.config import AdapterSettings
from jetcore.crypto import generate_encryption_keypair, generate_signing_keypair

NATS_URL = "nats://localhost:4222"
CREDS_DIR = "infra/nats/operator/creds"

LIST_REQUESTED = "events.files.FileListRequested"
LIST_COMPLETED = "events.files.FileListCompleted"
READ_REQUESTED = "events.files.FileReadRequested"
READ_COMPLETED = "events.files.FileReadCompleted"
DELETE_REQUESTED = "events.files.FileDeleteRequested"
DELETE_COMPLETED = "events.files.FileDeleteCompleted"
REQUEST_COMPLETED = "events.http.RequestCompleted"
ROW_CHANGED = "events.db.orders.RowChanged"


async def connect(service_id: str) -> BusClient:
    signing = generate_signing_keypair()
    encryption = generate_encryption_keypair()
    settings = AdapterSettings(
        service_id=service_id,
        nats_url=NATS_URL,
        nats_creds_path=f"{CREDS_DIR}/{service_id}.creds",
    )
    return await BusClient.connect(
        settings,
        adapter_type="k3-smoke-test",
        encryption_keypair=encryption,
        signing_seed=signing.seed,
        signing_public_key=signing.public_key,
    )


async def wait_cache(client: BusClient, subject: str, count: int = 1, timeout: float = 5.0) -> None:
    cache = await client._cache_for(subject)

    async def _poll() -> None:
        while len(cache.current()) < count:
            await asyncio.sleep(0.05)

    await asyncio.wait_for(_poll(), timeout=timeout)


async def part1_file_storage_list_read_delete() -> None:
    print("\n=== Part 1: File Storage list/read/delete via direct bus publish ===")
    observer = await connect("test-observer-01")
    try:
        list_durable = await observer.subscribe(LIST_COMPLETED, durable_name="k3-list")
        read_durable = await observer.subscribe(READ_COMPLETED, durable_name="k3-read")
        delete_durable = await observer.subscribe(DELETE_COMPLETED, durable_name="k3-delete")
        await wait_cache(observer, LIST_REQUESTED)
        await wait_cache(observer, READ_REQUESTED)
        await wait_cache(observer, DELETE_REQUESTED)

        await observer.publish(LIST_REQUESTED, json.dumps({"path": ""}).encode(), event_type="FileListRequested")
        [listed] = await observer.fetch(list_durable, timeout=5)
        entries = json.loads(listed.payload)["entries"]
        print("FileListCompleted entries:", entries)
        assert any(e["name"] == "k3-seed.txt" for e in entries), "seed file not found in listing"

        await observer.publish(
            READ_REQUESTED, json.dumps({"path": "k3-seed.txt"}).encode(), event_type="FileReadRequested"
        )
        [read] = await observer.fetch(read_durable, timeout=5)
        read_data = json.loads(read.payload)
        content = base64.b64decode(read_data["content"])
        print("FileReadCompleted content:", content)
        assert content == b"smoke test seed content\n"

        await observer.publish(
            DELETE_REQUESTED, json.dumps({"path": "k3-seed.txt"}).encode(), event_type="FileDeleteRequested"
        )
        [deleted] = await observer.fetch(delete_durable, timeout=5)
        print("FileDeleteCompleted:", json.loads(deleted.payload))
        print("Part 1: PASS")
    finally:
        await observer.close()


async def part2_order_created_fan_out() -> tuple[str, str]:
    """One real POST to the deployed REST API Service triggers THREE
    independent real consumers at once: the Webhook Sender (relays to
    the Webhook Listener -> FileWriteRequested -> a real file on disk),
    the HTTP Adapter (POSTs to the Webhook Listener's /healthz -> a real
    405 -> RequestCompleted), and the Database Adapter's write path
    (upsert -> OrderPersisted, resolved synchronously by the REST API
    Service's own ?wait= reply). Returns (order_id, rest_api_response)."""
    print("\n=== Part 2: one real POST fans out to Webhook Sender + HTTP Adapter + Database Adapter ===")
    import uuid

    import httpx

    observer = await connect("test-observer-01")
    try:
        request_completed_durable = await observer.subscribe(
            REQUEST_COMPLETED, durable_name="k3-request-completed"
        )
        await wait_cache(observer, REQUEST_COMPLETED)

        order_id = f"k3-smoke-{uuid.uuid4().hex[:8]}"
        body = json.dumps({"orderId": order_id, "item": "k3-widget", "quantity": 2}).encode()

        async with httpx.AsyncClient() as client:
            response = await client.post(
                "http://localhost:8081/api/orders?wait=10", content=body, timeout=15
            )
        print(f"POST /api/orders?wait=10 -> {response.status_code} {response.text}")
        assert response.status_code == 200, "REST API Service's real sync-reply round trip failed"
        persisted = response.json()
        assert persisted["orderId"] == order_id
        assert persisted["status"] == "persisted"
        print("REST API Service <-> Database Adapter sync-reply round trip: PASS")

        [http_result] = await observer.fetch(request_completed_durable, timeout=10)
        http_data = json.loads(http_result.payload)
        print("HTTP Adapter's RequestCompleted (from POSTing to /healthz):", http_data)
        assert http_data["statusCode"] == 405  # /healthz only accepts GET
        print("HTTP Adapter real outbound call: PASS")

        return order_id, json.dumps(persisted)
    finally:
        await observer.close()


def part3_webhook_sender_relay_landed_on_disk(order_id: str) -> None:
    print("\n=== Part 3: Webhook Sender's relay actually reached disk via the Webhook Listener ===")
    import time

    path = "infra/files/orders/relayed.json"
    for _ in range(50):
        if __import__("os").path.exists(path):
            break
        time.sleep(0.2)
    with open(path, "rb") as f:
        content = f.read()
    print("relayed.json content:", content)
    data = json.loads(content)
    assert data["orderId"] == order_id
    print("Webhook Sender -> Webhook Listener -> File Storage Adapter relay chain: PASS")


async def part4_cdc_direct_sql_write() -> None:
    print("\n=== Part 4: direct SQL INSERT bypassing the bus entirely -> CDC still fires ===")
    import uuid

    import pymysql

    observer = await connect("test-observer-01")
    try:
        row_changed_durable = await observer.subscribe(ROW_CHANGED, durable_name="k3-rowchanged")
        await wait_cache(observer, ROW_CHANGED)

        order_id = f"k3-direct-sql-{uuid.uuid4().hex[:8]}"
        conn = pymysql.connect(
            host="localhost", port=3306, user="root", password="dev-only-change-me",
            database="jetcore", autocommit=True,
        )
        try:
            cur = conn.cursor()
            cur.execute(
                "INSERT INTO orders (order_id, item, quantity) VALUES (%s, %s, %s)",
                (order_id, "direct-sql-widget", 5),
            )
        finally:
            conn.close()
        print(f"direct SQL INSERT for {order_id} — bus never touched")

        async def _poll() -> dict:
            while True:
                received = await observer.fetch(row_changed_durable, batch=10, timeout=2.0)
                for event in received:
                    data = json.loads(event.payload)
                    if data.get("row", {}).get("order_id") == order_id:
                        return data

        row_changed = await asyncio.wait_for(_poll(), timeout=15)
        print("RowChanged (from a write the bus never saw):", row_changed)
        assert row_changed["operation"] == "insert"
        assert row_changed["row"]["item"] == "direct-sql-widget"
        print("Part 4 (CDC read path is real, not an echo of bus writes): PASS")
    finally:
        await observer.close()


async def main() -> None:
    await part1_file_storage_list_read_delete()
    order_id, _ = await part2_order_created_fan_out()
    part3_webhook_sender_relay_landed_on_disk(order_id)
    await part4_cdc_direct_sql_write()
    print("\n=== Step K3: ALL PARTS PASSED ===")


asyncio.run(main())
