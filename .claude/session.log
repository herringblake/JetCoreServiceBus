Both created successfully. But "Per-Key TTL Supported: false" is worth pinning down precisely — --ttl here is a bucket-wide max-age applied per key's last-write timestamp, not NATS's separate opt-in "Per-Key TTL" feature (--marker-ttl, for different TTLs per key). For our design (every entry uses the same 60s TTL, refreshed by heartbeat), that's actually exactly the right mechanism — but let me verify the refresh/expiry behavior actually works as intended rather than assume:

Bash Empirically verify per-key TTL-refresh-on-write behavior with a short-lived throwaway bucket
IN
cd /home/bherring/dev/clodhopper/GregorsServiceBus
NATS_URL="nats://172.17.0.2:4222"
CREDS="infra/nats/operator/creds/gsb-admin.creds"

natsrun() {
  sg docker -c "docker run --rm -v \"\$(pwd)/infra/nats/operator/creds:/creds:ro\" natsio/nats-box:0.19.7-nonroot nats --server $NATS_URL --creds /creds/gsb-admin.creds $*"
}

natsrun "kv add ttl-test --ttl 5s --storage memory" >/dev/null 2>&1
echo "-- put key-a and key-b --"
natsrun "kv put ttl-test key-a val1"
natsrun "kv put ttl-test key-b val1"
sleep 3
echo "-- at t=3s, refresh key-a only --"
natsrun "kv put ttl-test key-a val2"
sleep 3
echo "-- at t=6s: key-a should be alive (refreshed at t=3), key-b should be expired (never refreshed, ttl=5s) --"
natsrun "kv get ttl-test key-a" 2>&1 | tail -3
echo "---"
natsrun "kv get ttl-test key-b" 2>&1 | tail -3

OUT
-- put key-a and key-b --
