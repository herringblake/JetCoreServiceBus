Bash Implement and test a custom nkey public-key decode + independent signature verification
IN
export PATH="$HOME/.local/bin:$PATH"
cd /home/bherring/dev/clodhopper/GregorsServiceBus
uv run --all-packages python3 -c "
import nkeys, base64, os
import nacl.signing, nacl.exceptions

def crc16(data: bytes) -> int:
    crc = 0
    for b in data:
        crc ^= b << 8
        for _ in range(8):
            if crc & 0x8000:
                crc = (crc << 1) ^ 0x1021
            else:
                crc = crc << 1
            crc &= 0xFFFF
    return crc

def decode_nkey_public(encoded: bytes) -> bytes:
    padding = b'=' * (-len(encoded) % 8)
    raw = base64.b32decode(encoded + padding)
    prefix = raw[0]
    key = raw[1:-2]
    crc_given = int.from_bytes(raw[-2:], 'little')
    crc_calc = crc16(raw[:-2])
    if crc_given != crc_calc:
        raise ValueError('bad crc')
    if prefix != nkeys.PREFIX_BYTE_USER:
        raise ValueError(f'unexpected prefix {prefix}')
    return key

# generate a real keypair the normal way
raw_seed = os.urandom(32)
seed = nkeys.encode_seed(raw_seed, nkeys.PREFIX_BYTE_USER)
kp = nkeys.from_seed(seed)
pub_str = kp.public_key
print('pub_str:', pub_str)

decoded = decode_nkey_public(pub_str)
print('decoded len:', len(decoded))

actual_verify_key_bytes = bytes(kp._keys.verify_key)
print('match:', decoded == actual_verify_key_bytes)

# now do a full sign + independent verify using ONLY the decoded public key
msg = b'integration test payload'
sig = kp.sign(msg)
vk = nacl.signing.VerifyKey(decoded)
try:
    vk.verify(msg, sig)
    print('verification with public-key-only: OK')
except nacl.exceptions.BadSignatureError:
    print('verification FAILED')

try:
    vk.verify(b'tampered', sig)
    print('tampered verification: OK (BAD, should have failed)')
except nacl.exceptions.BadSignatureError:
    print('tampered verification correctly rejected')
"

