async def _wait_until_cache_nonempty(cache, *, timeout: float = 3.0) -> None:  # noqa: ANN001
    async def _poll() -> None:
        while not cache.current():
            await asyncio.sleep(0.05)

    await asyncio.wait_for(_poll(), timeout=timeout)


