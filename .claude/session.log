=== root pyproject.toml ===
# Gregor's Service Bus — uv workspace root (Decision #16, Design.md §7.5)
#
# This root is "virtual" (tool.uv.package = false) — it's not itself an
# installable package, just the workspace container plus shared dev tooling
# config and the shared dev dependency group. Real packages live under
# libs/ (gsb-core) and adapters/ (populated starting Phase 3).

[project]
name = "gregors-service-bus"
version = "0.1.0"
requires-python = ">=3.12"
dependencies = []

[tool.uv]
package = false

[tool.uv.workspace]
members = ["libs/*", "adapters/*"]

[dependency-groups]
# Shared across the whole workspace (Design.md §7.4). bandit/pip-audit/
# pre-commit are here as CLI tools invoked via `uv run`, not as runtime deps
# of any package.
dev = [
    "pytest>=8",
    "pytest-asyncio>=0.24",
    "pytest-cov>=6",
    "ruff>=0.8",
    "mypy>=1.13",
    "bandit>=1.8",
=== libs/gsb-core/pyproject.toml ===
# gsb-core — shared library used by every adapter (Design.md §7.1)
#
# Dependencies added incrementally as each module (Design.md §11 Track B) is
# actually built: pydantic + uuid6 land in B2 (envelope.py). pyrage/nkeys
# (B3), nats-py (B5/B6) etc. still pending.

[project]
name = "gsb-core"
version = "0.1.0"
requires-python = ">=3.12"
dependencies = [
    "nats-py[nkeys]>=2.15.0",
    "pydantic>=2.9",
    "pydantic-settings>=2.15.0",
    "pyrage>=1.4.0",
    "uuid6>=2024.7.10",
]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

