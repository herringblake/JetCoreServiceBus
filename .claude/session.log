27 lines
import asyncio
import sys

sys.path.insert(0, "adapters/rest_api_service/tests")
from _rest_api_service_helpers import ORDER_CREATED_SUBJECT, ORDER_PERSISTED_SUBJECT, connect


async def main() -> None:
    replier = await connect("db-adapter-mysql-01")
    try:
        durable = await replier.subscribe(ORDER_CREATED_SUBJECT, durable_name="manual-verify-i7")
        [triggering] = await replier.fetch(durable, timeout=10)
        await triggering.ack()
        print("saw OrderCreated eventId:", triggering.details.event_id)
        await replier.publish(
            ORDER_PERSISTED_SUBJECT,
            b'{"orderId": "manual-verify", "status": "persisted"}',
            event_type="OrderPersisted",
            correlation_id=triggering.details.event_id,
        )
        print("published OrderPersisted")
    finally:
        await replier.close()


asyncio.run(main())
