# Step B1 (Design.md §7.4, §11 Track B). Hooks shell out to `uv run` rather
# than letting pre-commit provision its own per-hook environments — reuses
# the project's one uv-managed venv instead of duplicating it.
#
# This file is checked in but hooks are NOT auto-installed into .git/hooks —
# that's a per-developer choice. Run `uv run pre-commit install` to enable
# them locally.
repos:
  - repo: local
    hooks:
      - id: ruff-check
        name: ruff check
        entry: uv run ruff check --fix
        language: system
        types: [python]
      - id: ruff-format
