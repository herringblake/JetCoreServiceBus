# infra/nats/nats-server.conf
# Phase 1, Step A4 (Design.md §11 Track A)
#
# Client + monitoring listeners, JetStream storage, and auth. Auth is wired
# in via `include resolver.conf` below — resolver.conf is generated by
# bootstrap_auth.sh (Step A3), not hand-written, and is git-ignored. Run
# that script first if it doesn't exist yet.

listen: 0.0.0.0:4222
http_port: 8222   # monitoring endpoint (/varz, /healthz, ...) — Design.md §7.6

jetstream {
  # Overridden by the docker-compose volume mount in Step A6; this default
  # matches where that mount will land.
  store_dir: /data/jetstream

  # Dev-sized defaults — adjust if local storage needs grow. NATS docs'
  # own example uses 100G for max_file; that's a production-cluster figure,
  # not appropriate for a laptop dev environment.
  max_mem: 256M
  max_file: 2G
}

# NOTE: `include`'s path resolves relative to *this* file's directory, not
# the directory the server is launched from (confirmed via NATS docs) — so
# this only works because resolver.conf lives alongside nats-server.conf in
# infra/nats/, and both get mounted into the container together (Step A6).
include resolver.conf
