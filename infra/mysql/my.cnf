# MySQL server config for the Database Adapter's CDC read path (Design.md
# §13 Step J1, Decision #15). Mounted into the `mysql` Compose service at
# /etc/mysql/conf.d/jetcore.cnf — MySQL's own default config already
# `!includedir`s that directory, so nothing else needs to change to pick
# this up.
#
# The three settings python-mysql-replication actually needs to tail the
# binlog at all: binary logging enabled, row-based (not statement-based —
# CDC needs the actual before/after row values, not just the SQL that ran),
# and a unique server-id (the replication protocol's own requirement, even
# though this adapter is the only "replica" ever connecting).
[mysqld]
server-id            = 1
log_bin               = mysql-bin
binlog_format         = ROW

# Full row images for BOTH before and after values on UPDATE/DELETE (MySQL's
# own default, set explicitly rather than relied upon) — the CDC shape
# (Design.md §13 parameter table) needs a genuine `previousRow` on update,
# not just the changed columns.
binlog_row_image      = FULL

# Row-level column-name metadata in the binlog itself — lets the CDC read
# path map column values back to names without a separate schema lookup
# against INFORMATION_SCHEMA at parse time.
binlog_row_metadata   = FULL
